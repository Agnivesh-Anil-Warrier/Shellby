# ==============================================================================
# Shellby .gitignore
# ==============================================================================

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Environment variables & secrets (Gemini API keys, credentials)
.env
.env.*
!.env.example
*.pem
*.key

# Unit test & coverage artifacts
.pytest_cache/
.coverage
.coverage.*
nosetests.xml
coverage.xml
htmlcov/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.ruff_cache/

# Shellby runtime & local library metadata
.shellby-library.json
**/.shellby-library.json
sessions/
*.raw.log
*.tmp

# Operating System & Filesystem Artifacts
*:Zone.Identifier
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editor configurations
.idea/
.vscode/
*.swp
*.swo
*~
*.bak

# Logs & scratch files
*.log
drawbacks.txt
ss.txt
text.txt
ttt.txt
qt_test.py
test_render.py
